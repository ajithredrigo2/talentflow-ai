# ---- TalentFlow AI environment configuration ----
# Copy to .env.local for local development. NEVER commit real values.

# AI provider (optional). If unset, the platform runs its deterministic
# agent reasoning engine so the demo always works offline.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini            # gemini | openai | deterministic
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# Auth / session signing secret (any long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Demo credentials shown on the login screen (demo data only, no real users)
NEXT_PUBLIC_DEMO_MODE=true

# Optional persistence layer. Prototype defaults to the in-memory seeded store.
DATABASE_URL=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# ---- Zero-Touch Candidate Intake: recruitment mailbox integration ----
# All mailbox access is server-side. Never expose these in browser code.
# Leave every value empty to run the demonstration mailbox instead.

# Microsoft 365 / Outlook via Microsoft Graph (OAuth 2.0 client credentials)
# Application permissions: Mail.Read (and Mail.Send only if acknowledgements are on),
# scoped to the recruitment mailboxes with an application access policy.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Gmail / Google Workspace (OAuth 2.0 refresh token)
# Scopes: gmail.readonly (and gmail.send only if acknowledgements are on)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Generic IMAP fallback (requires the polling worker deployment)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
