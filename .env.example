# ---- TalentFlow AI environment configuration ----
# Copy to .env.local for local development. NEVER commit real values.

# AI provider (optional). If unset, the platform runs its deterministic
# agent reasoning engine so the demo always works offline.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini            # gemini | openai | deterministic
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# Auth / session signing secret (any long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Demo credentials shown on the login screen (demo data only, no real users)
NEXT_PUBLIC_DEMO_MODE=true

# Optional persistence layer. Prototype defaults to the in-memory seeded store.
DATABASE_URL=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
